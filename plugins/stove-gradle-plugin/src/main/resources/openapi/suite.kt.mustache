private fun segmentPattern(value: String): String = buildString {
  val hex = "0123456789ABCDEF"
  for (byte in value.toByteArray(Charsets.UTF_8)) {
    val octet = byte.toInt() and 255
    val c = octet.toChar()
    val encoded = "(?i:%${hex[octet ushr 4]}${hex[octet and 15]})"
    // The literal and escaped forms start differently, so the matcher never needs to backtrack.
    if (c in 'a'..'z' || c in 'A'..'Z' || c in '0'..'9' || c in "-._~!$&'()*+,;=:@") {
      append("(?>${Pattern.quote(c.toString())}|$encoded)")
    } else append(encoded)
  }
}

// Writes dates as a client sends them, without needing jsr310 on the classpath.
private val mapper = com.fasterxml.jackson.module.kotlin.jacksonObjectMapper().registerModule(
  com.fasterxml.jackson.databind.module.SimpleModule()
    .iso<java.time.OffsetDateTime>(java.time.format.DateTimeFormatter.ISO_OFFSET_DATE_TIME)
    .iso<java.time.LocalDate>(java.time.format.DateTimeFormatter.ISO_LOCAL_DATE)
    .iso<java.time.Instant>(java.time.format.DateTimeFormatter.ISO_INSTANT)
)

private inline fun <reified T : java.time.temporal.TemporalAccessor> com.fasterxml.jackson.databind.module.SimpleModule.iso(
  format: java.time.format.DateTimeFormatter,
) = addSerializer(T::class.java, object : com.fasterxml.jackson.databind.JsonSerializer<T>() {
  override fun serialize(value: T, gen: com.fasterxml.jackson.core.JsonGenerator, p: com.fasterxml.jackson.databind.SerializerProvider) =
    gen.writeString(format.format(value))
})

/** Ignores array order. A null field matches an absent field or any value; unexpected fields do not match. */
private fun stubBody(value: Any?) =
  com.github.tomakehurst.wiremock.client.WireMock.equalToJson(mapper.writeValueAsString(optional(mapper.valueToTree(value))), true, false)

private fun optional(node: com.fasterxml.jackson.databind.JsonNode): com.fasterxml.jackson.databind.JsonNode = node.apply {
  when (this) {
    is com.fasterxml.jackson.databind.node.ObjectNode -> properties().forEach { field ->
      field.setValue(if (field.value.isNull) textNode("\${json-unit.ignore-element}") else optional(field.value))
    }
    is com.fasterxml.jackson.databind.node.ArrayNode -> forEach(::optional)
  }
}

