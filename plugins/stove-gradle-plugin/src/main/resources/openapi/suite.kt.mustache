private fun encodeSegment(value: String): String = buildString {
  val hex = "0123456789ABCDEF"
  for (byte in value.toByteArray(Charsets.UTF_8)) {
    val octet = byte.toInt() and 255
    val c = octet.toChar()
    if (c in 'a'..'z' || c in 'A'..'Z' || c in '0'..'9' || c in "-._~!$&'()*+,;=:@") append(c)
    else append('%').append(hex[octet ushr 4]).append(hex[octet and 15])
  }
}

