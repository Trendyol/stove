FROM golang:1.27.3@sha256:e519d3b0a5b285e5aa53ab9eef02bc6bbb9cb04608389b743a136a9ce75f0d1e AS build

WORKDIR /workspace/recipes/process/golang/go-showcase
COPY go/stove-profiler /workspace/go/stove-profiler
COPY recipes/process/golang/go-showcase/go.mod recipes/process/golang/go-showcase/go.sum ./
RUN go mod download
COPY recipes/process/golang/go-showcase/*.go ./

ARG GO_BUILD_FLAGS=""
RUN CGO_ENABLED=0 GOOS=linux go build ${GO_BUILD_FLAGS} -o /out/go-showcase .

FROM alpine:3.24
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=build /out/go-showcase /app/go-showcase

EXPOSE 8090
ENTRYPOINT ["/app/go-showcase"]
