# The stove-server image only needs the CLI sources, its shared protobuf contract,
# and the repository version. Keep the build context small and deterministic.
*
!gradle.properties
!tools/
!server/stove-server/
!server/stove-server/**
!lib/
!lib/stove-dashboard-api/
!lib/stove-dashboard-api/src/
!lib/stove-dashboard-api/src/main/
!lib/stove-dashboard-api/src/main/proto/
!lib/stove-dashboard-api/src/main/proto/**

server/stove-server/target/
server/stove-server/spa/dist/
server/stove-server/spa/node_modules/
server/stove-server/**/*.log
server/stove-server/.idea/
server/stove-server/.vscode/
