# The stove-cli image only needs the CLI sources, its shared protobuf contract,
# and the repository version. Keep the build context small and deterministic.
*
!gradle.properties
!tools/
!tools/stove-cli/
!tools/stove-cli/**
!lib/
!lib/stove-dashboard-api/
!lib/stove-dashboard-api/src/
!lib/stove-dashboard-api/src/main/
!lib/stove-dashboard-api/src/main/proto/
!lib/stove-dashboard-api/src/main/proto/**

tools/stove-cli/target/
tools/stove-cli/spa/dist/
tools/stove-cli/spa/node_modules/
tools/stove-cli/**/*.log
tools/stove-cli/.idea/
tools/stove-cli/.vscode/
